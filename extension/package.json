{
  "name": "comp-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Comp — an activity-aware companion browser extension that reacts with ASCII art and encouragement instead of suggestions.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
